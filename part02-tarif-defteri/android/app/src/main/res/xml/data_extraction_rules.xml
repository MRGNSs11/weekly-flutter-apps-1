<?xml version="1.0" encoding="utf-8"?>
<!--
  Tarifler bu telefondan çıkmıyor.

  `allowBackup="false"` tek başına yetmiyor: Android 12'den itibaren
  buluta yedekleme ile cihazdan cihaza aktarım AYRI iki yol ve ikincisini
  yalnızca bu dosya kapatıyor.

  Veri kaybı riski yok — uygulamanın kendi JSON yedeği var, kullanıcı
  yedeğini kendi alıyor. Karar burada: yedek Google'ın değil, annenin
  elinde olsun.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
