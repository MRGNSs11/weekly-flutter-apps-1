<?xml version="1.0" encoding="utf-8"?>
<!--
  Bu uygulamanın kullanıcı verisi YOK: hesap, ayar, veritabanı yok. Deprem
  kayıtları bellekte tutuluyor, uygulama kapanınca gidiyor. Diskte kalan tek
  şey harita karosu önbelleği (cache/fm_cache, en fazla 50 MB).

  `allowBackup="false"` tek başına yetmiyor: Android 12'den itibaren buluta
  yedekleme ile cihazdan cihaza aktarım AYRI iki yol, ikincisini yalnızca
  bu dosya kapatıyor.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
