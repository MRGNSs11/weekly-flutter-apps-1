# Her uygulama klasörünün kendi .gitignore'u var (Flutter'ın ürettiği).
# Burası sadece depo genelinde geçerli olanlar için.

# İşletim sistemi
.DS_Store
Thumbs.db
desktop.ini

# Editör
.idea/
.vscode/
*.iml
*.swp

# ─── ÖZEL — Ömer'in çalışma belgeleri, PUBLIC OLMAZ ───
# Beyaz liste: bütün .md / .html / .pdf dosyaları varsayılan olarak ÖZEL.
# Public'e yalnız aşağıda "!" ile açılanlar gider. Yeni bir seçenek sayfası
# (tasarım, ikon, font...) adı ne olursa olsun kendiliğinden dışarıda kalır.
*.md
*.html
*.pdf
!README.md
!VAKA.md
!**/web/index.html

# ─── GÜVENLİK — bunlar asla depoya girmemeli ───
# Bir uygulamanın kendi .gitignore'u eksik kalırsa buradaki kurallar yakalar.
*.jks
*.keystore
*.p12
*.pfx
*.pem
key.properties
local.properties
google-services.json
GoogleService-Info.plist
.env
.env.*
dart_define*.json
secrets*.json
