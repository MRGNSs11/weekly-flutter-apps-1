# Her uygulama klasörünün kendi .gitignore'u var (Flutter'ın ürettiği).
# Burası sadece depo genelinde geçerli olanlar için.

# İşletim sistemi
.DS_Store
Thumbs.db
desktop.ini

# Editör
.idea/
.vscode/
*.iml
*.swp

# ─── GÜVENLİK — bunlar asla depoya girmemeli (bkz. GUVENLIK.md) ───
# Bir uygulamanın kendi .gitignore'u eksik kalırsa buradaki kurallar yakalar.
*.jks
*.keystore
*.p12
*.pfx
*.pem
key.properties
local.properties
google-services.json
GoogleService-Info.plist
.env
.env.*
dart_define*.json
secrets*.json
