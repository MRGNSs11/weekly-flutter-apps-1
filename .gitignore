# Her uygulama klasörünün kendi .gitignore'u var (Flutter'ın ürettiği).
# Burası sadece depo genelinde geçerli olanlar için.

# İşletim sistemi
.DS_Store
Thumbs.db
desktop.ini

# Editör
.idea/
.vscode/
*.iml
*.swp

# ─── ÖZEL — bunlar Ömer'in kişisel çalışma belgeleri, PUBLIC OLMAZ ───
# Diskte dururlar, depoya girmezler. Public repoda sadece uygulama kodu ve
# uygulamaya özel vaka raporu bulunur.
PLAN_REHBERI.md
VAKA_REHBERI.md
GUVENLIK.md
FIKIRLER.md
VITRIN_PLANI.md
tasarim-secenekleri.html
ikon-secenekleri.html
*/PLAN.md
*/linkedin-gonderisi.md
*/tasarimlar.html

# ─── GÜVENLİK — bunlar asla depoya girmemeli ───
# Bir uygulamanın kendi .gitignore'u eksik kalırsa buradaki kurallar yakalar.
*.jks
*.keystore
*.p12
*.pfx
*.pem
key.properties
local.properties
google-services.json
GoogleService-Info.plist
.env
.env.*
dart_define*.json
secrets*.json
